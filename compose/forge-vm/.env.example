# Copy to compose/forge-vm/.env and fill it in. Compose reads that file; this one is never read.

# The service user setup.sh creates to own the forge's folders (default forge).
FORGE_USER=forge
# The user id and group id of FORGE_USER, so the files in the data folder are its own (default 1100).
FORGE_UID=1100
FORGE_GID=1100
# The VM address Forgejo listens on, so a browser and the runner can reach it. No default: fill it in.
FORGE_BIND=
# The port of Forgejo's page (default 3000).
FORGE_PORT=3000
# The address people and agents use to reach the forge, with a trailing slash, e.g. http://192.168.1.50:3000/. No default: fill it in.
FORGE_URL=
# The host part of FORGE_URL, without port or scheme, e.g. 192.168.1.50. Compose cannot cut it out of the URL, so it is typed here. No default.
FORGE_DOMAIN=
# Where the TrueNAS share is mounted on the VM; setup.sh mounts it and compose keeps the data there (default /srv/forge-data).
FORGE_DATA=/srv/forge-data
# The TrueNAS share's server address. Used by setup.sh (ST77) only; listed here so one file holds everything. No default.
TRUENAS_ADDR=
# The NFS export path on that server, e.g. /mnt/pool/forge. Used by setup.sh (ST77) only. No default.
TRUENAS_EXPORT=
# The first admin user of the forge, created once by the init service. Default forge-admin.
FORGE_ADMIN_USER=forge-admin
# The admin user's email address. No default: fill it in.
FORGE_ADMIN_EMAIL=
# The admin user's password. A secret: no default, never committed. Keep it only in this git-ignored .env.
FORGE_ADMIN_PASSWORD=
