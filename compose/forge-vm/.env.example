# Written by compose/forge-vm/setup.sh (ST93): it asks for each value, with its default; Enter accepts.
# The script fills this template in and writes compose/forge-vm/.env (git-ignored, mode 600). Nothing
# reads this file itself.

# The service user setup.sh creates to own the forge's folders (default forge).
FORGE_USER=forge
# The user id and group id of FORGE_USER, so the files in the data folder are its own (default 1100).
FORGE_UID=1100
FORGE_GID=1100
# The VM address Forgejo listens on, so a browser and the runner can reach it. Default: the VM's address on its default route (never a Docker bridge).
FORGE_BIND=
# The port of Forgejo's page (default 3000).
FORGE_PORT=3000
# The address people and agents use to reach the forge, with a trailing slash. Default: built from FORGE_BIND and FORGE_PORT.
FORGE_URL=
# The folder on the VM where Forgejo keeps its data: the second disk, mounted at /data, in a subfolder (default /data/forgejo). It is a local disk, not a network share.
FORGE_DATA=/data/forgejo
# The first admin user of the forge, created once by the init service. Default forge-admin.
FORGE_ADMIN_USER=forge-admin
# The admin user's email address. No default: the script asks for it.
FORGE_ADMIN_EMAIL=
# The admin user's password. A secret: generated by default and never printed; kept only in this git-ignored .env.
FORGE_ADMIN_PASSWORD=
