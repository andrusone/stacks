# Written by compose/runner-vm/setup.sh (ST95): it asks for each value, with its default; Enter accepts.
# The script fills this template in and writes compose/runner-vm/.env (git-ignored, mode 600). Compose
# reads that file; this one is never read.

# The service user setup.sh creates to run the runner and own its folder (default runner).
RUNNER_USER=runner
# The user id of RUNNER_USER, so the files in the data folder are its own (default 1200).
RUNNER_UID=1200
# The group id of RUNNER_USER (default 1200).
RUNNER_GID=1200
# The group id of the VM's docker group. Not asked: setup.sh fills it in once Docker is installed, from the group it finds on the VM.
DOCKER_GID=
# The folder on the VM where the runner keeps its registration, mounted at /data (default /srv/runner).
RUNNER_DATA=/srv/runner
# The name the forge shows for this runner. Default: the VM's host name.
RUNNER_NAME=
# The address of the forge, the same one people use, with no trailing slash, e.g. http://192.168.1.50:3000. No default: the script asks for it.
FORGE_URL=
# A one-time registration token, the runner's only secret. No default: the script asks for it, typed hidden (or a file's first line, if you give the file's path). Never printed. Get it from the forge's web page: Settings, then Actions, then Runners, then create a new runner and copy its token. The runner registers with it on its first up; a rerun of setup.sh asks for it again while this line is empty.
RUNNER_REGISTRATION_TOKEN=
# An address the runner must not reach (the TrueNAS web or API address). Used only by setup.sh to block outbound traffic at the VM's firewall; compose does not read it. No default: the script asks for it.
TRUENAS_ADDR=
# An address the runner must not reach (the Proxmox API address). Used only by setup.sh to block outbound traffic at the VM's firewall; compose does not read it. No default: the script asks for it.
PROXMOX_ADDR=
