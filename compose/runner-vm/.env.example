# Copy to compose/runner-vm/.env and fill it in. Compose reads that file; this one is never read.

# The service user setup.sh creates to run the runner and own its folder (default runner).
RUNNER_USER=runner
# The user id of RUNNER_USER, so the files in the data folder are its own (default 1200).
RUNNER_UID=1200
# The group id of RUNNER_USER (default 1200).
RUNNER_GID=1200
# The group id of the VM's docker group. setup.sh fills it in when this is empty, from the group it finds on the VM; set it by hand only if you want another value.
DOCKER_GID=
# The folder on the VM where the runner keeps its registration, mounted at /data (default /srv/runner).
RUNNER_DATA=/srv/runner
# The name the forge shows for this runner, e.g. runner-vm. No default: fill it in.
RUNNER_NAME=
# The address of the forge, the same one people use, with no trailing slash, e.g. http://192.168.1.50:3000. No default: fill it in.
FORGE_URL=
# A one-time registration token, the runner's only secret. No default, never committed: the owner pastes it here. Get it from the forge's web page: Settings, then Actions, then Runners, then create a new runner and copy its token. After the first up it is not needed again, so you may clear it.
RUNNER_REGISTRATION_TOKEN=
# An address the runner must not reach (the TrueNAS web or API address). Used only by setup.sh (ST79) to block outbound traffic at the VM's firewall; compose does not read it. No default: fill it in.
TRUENAS_ADDR=
# An address the runner must not reach (the Proxmox API address). Used only by setup.sh (ST79) to block outbound traffic at the VM's firewall; compose does not read it. No default: fill it in.
PROXMOX_ADDR=
