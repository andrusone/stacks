# The service user setup.sh creates to own the monitor's folders (default monitor).
MONITOR_USER=monitor
# Where the monitor keeps its state: the Gatus config and ntfy's cache (default /srv/monitor).
MONITOR_DIR=/srv/monitor
# The VM address Gatus and ntfy listen on, so a browser and a phone can reach them. No default: fill it in.
MONITOR_BIND=
# The port of Gatus's page (default 8081).
GATUS_PORT=8081
# The port of ntfy (default 8090).
NTFY_PORT=8090
# The phone's topic: a secret, never committed (HL-NFR-02). No default: fill it in.
NTFY_TOPIC=
