# The monitor's values. ./setup.sh asks for each one, with a default: Enter accepts it. An environment
# variable of the same name skips its prompt, and a value already set here is the default on a rerun.
# The service user that owns the monitor's folders (default monitor).
MONITOR_USER=monitor
# Where the monitor keeps its state: the Gatus config and ntfy's cache (default /srv/monitor).
MONITOR_DIR=/srv/monitor
# The VM address Gatus and ntfy listen on (the default route's address, asked for). Empty here: setup.sh fills it in.
MONITOR_BIND=
# The port of Gatus's page (default 8081).
GATUS_PORT=8081
# The port of ntfy (default 8090).
NTFY_PORT=8090
# The phone's topic: a secret, never committed (HL-NFR-02). Empty here: setup.sh generates one (default), or you type your own.
NTFY_TOPIC=
# The port of the Beszel hub's page (default 8091; 8090 is ntfy's). Not asked by setup.sh: compose falls back to 8091 when it is unset.
BESZEL_PORT=8091
