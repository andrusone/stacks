# Pins and paths for compose/plex (ST207). Copy to compose/plex/.env for real values (MVP 2).
#
# Images are pinned by tag and digest. Digests from the Docker Hub tag API and
# `docker manifest inspect`, 2026-11-20.
# Plex: the official plexinc/pms-docker image (not linuxserver/plex).
# Kometa: kometateam/kometa has no 2.4.8 tag; the tag is v2.4.8 (= KOMETA_VERSION 2.4.8).
PLEX_IMAGE=plexinc/pms-docker:1.43.5.11079-b3b13e506@sha256:6d778d41daae68f89115aa87a44ae14a96b23e71a2093da173b5a9aac4091336
KOMETA_IMAGE=kometateam/kometa:v2.4.8@sha256:c58f6d4af511613f218b6dafbfc84078af4e5a6089790c1fdba58fd7c5dad70a

# Relative to compose/plex/ (docker compose resolves bind paths from the compose file's folder).
PLEX_DATA=./data/plex
KOMETA_CONFIG=./data/kometa
PLEX_MEDIA=./data/media
