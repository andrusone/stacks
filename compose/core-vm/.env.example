# compose/core-vm/.env: the values for one core node (CORE-FR-10, ST218). setup.sh asks for them once
# and writes this file; a rerun reuses it. Plain values, no secrets. Git ignores the file.
# CORE_BIND: this VM's own IPv4 address. Enter takes the default-route address.
CORE_BIND=
# CORE_LAN: the LAN as an IPv4 CIDR. host.sh opens DNS and NTP to it. Default: this address's /24.
CORE_LAN=
# CORE_ADMIN: the IPv4 address or CIDR allowed to SSH in. Default: the machine you are logging in from.
CORE_ADMIN=
# CORE_ZONE_URL: the zone repository by address, never a name, for example http://192.168.1.20/zone.git.
# Until the forge exists, this is the zone repository's address on the owner's Git host.
CORE_ZONE_URL=
# CORE_ROLE: primary or secondary (CORE-FR-08). This setup records it; BIND's role is a later story.
CORE_ROLE=primary
# CORE_PEER: the other node's IPv4 address. Empty until that node exists.
CORE_PEER=
